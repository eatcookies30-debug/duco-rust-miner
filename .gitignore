# Rust build artefacts
miner/target/

# Python
__pycache__/
*.pyc

# Your own settings and logs. Settings.cfg holds your username and your
# base64-encoded mining key, so it must never be committed.
Settings.cfg
*.log

# arduino-cli leaves build caches inside sketch folders
build/
sketch_build/

# scratch output of gen_asm.py when run without an output path
rounds_body.inc

# the desktop I2C glue test is built in place
firmware/i2c_slave_test/slave_test

# firmware/tiny85/build.sh writes the .elf and .hex next to the source; build
# them yourself, they are chip specific
firmware/tiny85/*.elf
firmware/tiny85/*.hex
