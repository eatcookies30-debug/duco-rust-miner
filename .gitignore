# Rust build artefacts
miner/target/

# Python
__pycache__/
*.pyc

# Your own settings and logs. Settings.cfg holds your username and your
# base64-encoded mining key, so it must never be committed.
Settings.cfg
*.log

# arduino-cli leaves build caches inside sketch folders
build/
sketch_build/

# scratch output of gen_asm.py when run without an output path
rounds_body.inc

# the bare-metal builds write their .elf and .hex next to the source; they are
# chip specific, so build them yourself rather than carry them in the repo
firmware/baremetal/*.elf
firmware/baremetal/*.hex
firmware/baremetal/*.lst
